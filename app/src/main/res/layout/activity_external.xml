<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_obsidian">

    <!-- Custom Background Image Layer -->
    <ImageView
        android:id="@+id/ivExtBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- 1. Windows Style Desktop Workspace Container -->
    <RelativeLayout
        android:id="@+id/launcherContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Left Desktop Icons Column / Grid (Pinned Favorite Apps) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDesktopIcons"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:layout_above="@id/layoutTaskbar"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp"
            android:overScrollMode="never"
            android:nestedScrollingEnabled="false"
            android:scrollbars="none"
            tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            tools:spanCount="5"
            tools:listitem="@layout/item_desktop_icon" />

        <!-- Resolution & Glasses Status Info Badge (Top-Right of Desktop) -->
        <TextView
            android:id="@+id/tvExtHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_rounded_search"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="4K 3840×2160"
            android:textColor="@color/neon_emerald"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <!-- 💖 Desktop Support Creator Widget (Bottom-Right of Desktop, above Taskbar) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardDesktopSupport"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_above="@id/layoutTaskbar"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="#CC1E222B"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvSupportMsg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💖 Love Xternal Control? Support creator's family with a coffee!"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:lineSpacingExtra="2dp" />

                <LinearLayout
                    android:id="@+id/btnBuyMeCoffee"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_gravity="end"
                    android:background="@drawable/bg_rounded_search"
                    android:backgroundTint="#FFDD00"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="☕ BUY ME A COFFEE"
                        android:textColor="#000000"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 🪟 Windows Start Menu Popup (Centered above Start Button) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/layoutStartMenu"
            android:layout_width="340dp"
            android:layout_height="440dp"
            android:layout_centerHorizontal="true"
            android:layout_above="@id/layoutTaskbar"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#F2161A22"
            app:cardElevation="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="14dp">

                <!-- Start Menu Header: Search Box -->
                <EditText
                    android:id="@+id/etStartMenuSearch"
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_alignParentTop="true"
                    android:background="@drawable/bg_white_search_box"
                    android:hint="Type here to search apps..."
                    android:textColorHint="#757575"
                    android:textColor="#121212"
                    android:textSize="12sp"
                    android:paddingHorizontal="14dp"
                    android:inputType="text"
                    android:maxLines="1"
                    android:imeOptions="actionSearch" />

                <!-- Start Menu Apps List / Grid -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvStartMenuApps"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@id/etStartMenuSearch"
                    android:layout_above="@id/layoutStartMenuFooter"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:scrollbars="vertical"
                    tools:listitem="@layout/item_start_menu_app" />

                <!-- Start Menu Footer Bar -->
                <RelativeLayout
                    android:id="@+id/layoutStartMenuFooter"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_alignParentBottom="true"
                    android:background="#33FFFFFF"
                    android:paddingHorizontal="8dp">

                    <LinearLayout
                        android:id="@+id/btnStartGuide"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_rounded_search"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ℹ️ GUIDE"
                            android:textColor="@color/neon_cyan"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnCloseStartMenu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:text="✕ CLOSE"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:padding="6dp"
                        android:clickable="true"
                        android:focusable="true" />
                </RelativeLayout>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <!-- 🪟 Windows Bottom Taskbar -->
        <RelativeLayout
            android:id="@+id/layoutTaskbar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_alignParentBottom="true"
            android:background="@drawable/bg_taskbar"
            android:paddingHorizontal="12dp">

            <!-- Centered Start Menu & Pinned Taskbar Apps (Windows 11 Style) -->
            <LinearLayout
                android:id="@+id/layoutCenterTaskbar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- All Apps / Launcher Button (Modern 4-Tile Vector Grid) -->
                <ImageView
                    android:id="@+id/btnStartMenu"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_apps_grid"
                    android:scaleType="fitCenter"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="All Apps" />

                <!-- Taskbar Pinned Favorite Apps -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTaskbarApps"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:orientation="horizontal"
                    android:scrollbars="none"
                    tools:listitem="@layout/item_taskbar_app" />
            </LinearLayout>

            <!-- System Tray (Right Side: Battery, Time & Date) -->
            <LinearLayout
                android:id="@+id/layoutSystemTray"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Battery Percentage & Icon -->
                <TextView
                    android:id="@+id/tvBatteryPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔋 100%"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="12dp" />

                <!-- Date & Time (2 lines) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="end">

                    <TextView
                        android:id="@+id/tvTrayTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10:25 PM"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTrayDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="9/3/2026"
                        android:textColor="@color/text_secondary"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

        </RelativeLayout>

    </RelativeLayout>

    <!-- 2. Virtual Apps Overlay Container (for interactive demo) -->
    <FrameLayout
        android:id="@+id/virtualAppContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Simulated Web Browser App -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutBrowserApp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_panel"
            android:visibility="gone">

            <!-- Browser header -->
            <RelativeLayout
                android:id="@+id/browserHeader"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/bg_card"
                android:paddingHorizontal="16dp"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvBrowserTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="Virtual Web Browser"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnBrowserClose"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="CLOSE [X]"
                    android:textColor="@color/neon_danger"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"/>
            </RelativeLayout>

            <!-- Scrollable web contents -->
            <ScrollView
                android:id="@+id/browserScrollView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintTop_toBottomOf="@id/browserHeader"
                app:layout_constraintBottom_toBottomOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SCROLL DEMO PAGE"
                        android:textColor="@color/neon_cyan"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="This is a scrollable mock browser page. Drag two fingers up or down on the main device trackpad to scroll this content smoothly."
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        android:lineSpacingExtra="6dp" />

                    <Button
                        android:id="@+id/btnBrowserClickMe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:backgroundTint="@color/neon_violet"
                        android:text="CLICK ME VIA TRACKPAD"
                        android:textColor="@color/text_primary" />
                </LinearLayout>
            </ScrollView>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Simulated Notes App -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutNotesApp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_panel"
            android:visibility="gone">

            <RelativeLayout
                android:id="@+id/notesHeader"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/bg_card"
                android:paddingHorizontal="16dp"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="Virtual Notes Pad"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnNotesClose"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="CLOSE [X]"
                    android:textColor="@color/neon_danger"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"/>
            </RelativeLayout>

            <EditText
                android:id="@+id/etNotesArea"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:gravity="top|start"
                android:hint="Type notes from Phone Keyboard..."
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:padding="20dp"
                android:background="@null"
                app:layout_constraintTop_toBottomOf="@id/notesHeader"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Simulated Maps App -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutMapApp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/bg_panel"
            android:visibility="gone">

            <RelativeLayout
                android:id="@+id/mapHeader"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/bg_card"
                android:paddingHorizontal="16dp"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:text="Virtual Satellite Map"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnMapClose"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="CLOSE [X]"
                    android:textColor="@color/neon_danger"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"/>
            </RelativeLayout>

            <FrameLayout
                android:id="@+id/flMapCanvas"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintTop_toBottomOf="@id/mapHeader"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:id="@+id/ivMapImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_trackpad_grid" />

                <TextView
                    android:id="@+id/tvMapCoords"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_rounded_search"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:text="SATELLITE POSITION: SECTOR 4-B\nZoom Level: 1.0x"
                    android:textColor="@color/neon_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>

    <!-- 4. Global Navigation Overlay Pills -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvExtNavBar"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:visibility="gone"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="@color/bg_card"
        app:cardElevation="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/btnExtNavBack"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="← BACK"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"/>

            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:background="@color/glass_white_border"/>

            <TextView
                android:id="@+id/btnExtNavHome"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="HOME ⌂"
                android:textColor="@color/neon_cyan"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 5. Cursor, Ripple & Context Menu -->
    <ImageView
        android:id="@+id/ivCursor"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/bg_cursor"
        android:elevation="99dp"
        android:visibility="gone" />

    <View
        android:id="@+id/viewCursorRipple"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_cursor"
        android:alpha="0"
        android:elevation="98dp" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cvContextMenu"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:elevation="100dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/bg_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:id="@+id/tvContextBack"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:text="← Back"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground" />

            <TextView
                android:id="@+id/tvContextHome"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:text="⌂ Return to Desktop"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:clickable="true"
                android:focusable="true"
                android:background="?android:attr/selectableItemBackground" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</FrameLayout>
