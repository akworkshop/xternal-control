<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardTvBanner"
    android:layout_width="140dp"
    android:layout_height="60dp"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <RelativeLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Official Android TV Banner Image (if available) -->
        <ImageView
            android:id="@+id/ivBanner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <!-- Fallback Content (if no TV banner available) -->
        <LinearLayout
            android:id="@+id/layoutFallbackContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="10dp">

            <!-- App Icon -->
            <ImageView
                android:id="@+id/ivAppIcon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:scaleType="fitCenter"
                android:layout_marginEnd="8dp" />

            <!-- App Name -->
            <TextView
                android:id="@+id/tvAppName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="2"
                android:ellipsize="end"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Lock Badge for Free/Pro limits -->
        <TextView
            android:id="@+id/tvLockBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_margin="4dp"
            android:elevation="10dp"
            android:text="🔒"
            android:textSize="10sp"
            android:visibility="gone" />

    </RelativeLayout>
</androidx.cardview.widget.CardView>
